{
  "name": "projector",
  "productName": "Projector",
  "private": true,
  "version": "0.1.0",
  "author": "MIS 430 Team",
  "description": "A student starting point for UA campus resources. Interactive mockup with demo data.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "electron": "electron .",
    "electron:dev": "vite build && electron .",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "dist:win": "vite build && electron-builder --win --x64",
    "dist:mac": "vite build && electron-builder --mac"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "better-sqlite3": "^12.9.0",
    "officeparser": "^6.1.1",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.3",
    "vitest": "^3.2.7"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "edu.ua.mis430.projector",
    "productName": "Projector",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/**/*.test.js",
      "package.json"
    ],
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "jkillenit",
      "repo": "projector"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "signAndEditExecutable": false,
      "signDlls": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "identity": null,
      "category": "public.app-category.education"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Projector"
    }
  }
}
